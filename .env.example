# --- Aplicação ---
FLASK_ENV=development
SECRET_KEY=troque-por-um-texto-longo-e-aleatorio

# --- Banco de dados (os três primeiros são lidos pelo docker-compose.yml) ---
POSTGRES_USER=chamados
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=chamados_ti
DATABASE_URL=postgresql+psycopg2://chamados:troque-esta-senha@localhost:5432/chamados_ti

# Alternativa sem Docker (por exemplo, no PC da empresa):
# DATABASE_URL=sqlite:///teste.db

# --- E-mail (usado mais adiante) ---
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=chamados@empresa.com.br

# --- Anexos ---
MAX_UPLOAD_MB=10